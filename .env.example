# Copy this file to .env and fill in your Alpaca keys.
#   cp .env.example .env
# .env is listed in .gitignore, so your real keys are never committed.

ALPACA_API_KEY=your-alpaca-key-id
ALPACA_SECRET_KEY=your-alpaca-secret-key

# true = paper trading (simulated money). The bot refuses to run with false
# unless you also pass --allow-live, so live trading can't happen by accident.
ALPACA_PAPER=true
